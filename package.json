{
  "name": "leakx",
  "version": "1.0.3",
  "description": "A lightweight CLI tool that scans your codebase for hardcoded secrets, API keys, and passwords before they leak into version control.",
  "main": "dist/cli.js",
  "bin": {
    "leakx": "dist/cli.js"
  },
  "type": "commonjs",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "dev": "ts-node src/cli.ts"
  },
  "keywords": [
    "secret-scanner",
    "security",
    "cli",
    "api-keys",
    "leak-detection",
    "devsecops"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "fast-glob": "^3.3.2",
    "ignore": "^5.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=16"
  }
}
